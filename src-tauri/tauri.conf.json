{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KataGomo Studio",
  "version": "0.1.0",
  "identifier": "io.github.gaong5247.katagomogui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KataGomo Studio",
        "width": 1250,
        "height": 850,
        "minWidth": 850,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
